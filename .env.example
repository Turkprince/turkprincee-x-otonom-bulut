# Google AI Studio API Anahtarı (Ücretsiz: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# X (Twitter) Developer Portal OAuth 1.0a Anahtarları (Read + Write izinli: https://developer.x.com)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Opsiyonel: Make.com veya n8n Webhook URL (tanımlanırsa karar JSON çıktısı buraya da gönderilir)
AUTOMATION_WEBHOOK_URL=
